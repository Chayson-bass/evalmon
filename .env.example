# ── Required for eval judging ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=


# ── Optional: OpenAI (only if you use OpenAI clients) ─────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Optional: custom DB location (default: ~/.simpeval/simpeval.db) ────────────
# SIMPEVAL_DB_PATH=C:/Users/you/.simpeval/simpeval.db

# ── Optional: Slack alert webhook ─────────────────────────────────────────────
# SIMPEVAL_SLACK_WEBHOOK=https://hooks.slack.com/services/...

# ── Optional: email alerts via SMTP ───────────────────────────────────────────
# SIMPEVAL_ALERT_EMAIL=you@example.com
# SIMPEVAL_SMTP_HOST=smtp.gmail.com
# SIMPEVAL_SMTP_USER=you@gmail.com
# SIMPEVAL_SMTP_PASSWORD=your_app_password
